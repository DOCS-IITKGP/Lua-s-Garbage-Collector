+/* C.2: create a table from the frame arena (no GC linkage) */
+Table *luaH_new_arena (lua_State *L, FrameArena *arena) {
+  void *mem = luaM_arena_alloc(arena, sizeof(Table));
+  Table *t;
+  if (mem == NULL)
+      return luaH_new(L);  /* arena full — fall back to GC heap */
+  t = cast(Table *, mem);
+  /* Initialize like a normal table but WITHOUT GC linkage */
+  t->tt = LUA_VTABLE;
+  t->marked = 0;
+  t->next = NULL;  /* not in any GC list */
+  t->metatable = NULL;
+  t->flags = maskflags;
+  t->array = NULL;
+  t->asize = 0;
+  setnodevector(L, t, 0);
+  luaM_arena_register(L, arena, t);  /* C.2 */
+  return t;
+}
 
+
+/* C.2: free array and hash nodes without freeing the Table struct */
+void luaH_free_internals (lua_State *L, Table *t) {
+  freehash(L, t);
+  resizearray(L, t, t->asize, 0);
+}
