+                    ci->arena->num_tables = 0;
+                    ci->arena->used = 0;
+                }
+                t = luaH_new_arena(L, ci->arena);  /* C.2: arena allocation */
+            }
+            else
+                t = luaH_new(L);  /* normal GC heap allocation */
+        }
